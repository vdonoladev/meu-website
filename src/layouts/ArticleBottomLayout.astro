---
import { type CollectionEntry, getCollection } from "astro:content"
import { collectionRoute } from "@lib/utils"

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">
}

const { entry } = Astro.props
const { collection } = entry
const { Content, headings } = await entry.render()

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3)

const items = (await getCollection(collection))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const index = items.findIndex(x => x.slug === entry.slug)
const prev = items[(index - 1 + items.length) % items.length]
const next = items[(index + 1) % items.length]
---

<div>
  {tocHeadings.length >= 2 && (
    <details class="mb-8 rounded-lg border border-black/15 dark:border-white/20 bg-black/[0.02] dark:bg-white/[0.03] p-4 group">
      <summary class="cursor-pointer font-semibold text-sm uppercase tracking-wide text-black dark:text-white flex items-center justify-between select-none">
        <span>Neste artigo ({tocHeadings.length} tópicos)</span>
        <span class="text-xs opacity-60 group-open:rotate-180 transition-transform duration-200">▼</span>
      </summary>
      <nav aria-label="Índice do artigo" class="mt-3 pt-3 border-t border-black/10 dark:border-white/15">
        <ul class="space-y-1.5 text-sm">
          {tocHeadings.map((heading) => (
            <li class={heading.depth === 3 ? "pl-4" : ""}>
              <a
                href={`#${heading.slug}`}
                class="text-black/75 dark:text-white/75 hover:text-black dark:hover:text-white hover:underline underline-offset-2 blend"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )}

  <article>
    <Content/>
  </article>

  <aside class="my-8 p-5 rounded-lg border border-black/15 dark:border-white/20 bg-black/[0.02] dark:bg-white/[0.03] flex flex-col sm:flex-row gap-4 items-start sm:items-center justify-between">
    <div class="space-y-1">
      <div class="text-xs font-bold uppercase tracking-wider opacity-60">
        Escrito por
      </div>
      <div class="font-semibold text-black dark:text-white text-base">
        Víctor Donola Ferreira
      </div>
      <p class="text-sm opacity-80 max-w-xl">
        Desenvolvedor full-stack e fundador da <strong>VD Tech &amp; Suporte</strong>. Escrevo sobre código, Linux, infraestrutura e aprendizados práticos do mundo real.
      </p>
    </div>
    <div class="flex flex-wrap gap-2 shrink-0">
      <a
        href="https://www.linkedin.com/in/vdonolaferreira/"
        target="_blank"
        class="px-3 py-1.5 text-xs font-medium rounded border border-black/20 dark:border-white/25 hover:bg-black/5 dark:hover:bg-white/10 text-black dark:text-white blend"
      >
        LinkedIn
      </a>
      <a
        href="https://github.com/vdonoladev"
        target="_blank"
        class="px-3 py-1.5 text-xs font-medium rounded border border-black/20 dark:border-white/25 hover:bg-black/5 dark:hover:bg-white/10 text-black dark:text-white blend"
      >
        GitHub
      </a>
      <a
        href="/rss.xml"
        target="_blank"
        class="px-3 py-1.5 text-xs font-medium rounded border border-black/20 dark:border-white/25 hover:bg-black/5 dark:hover:bg-white/10 text-black dark:text-white blend"
      >
        RSS
      </a>
    </div>
  </aside>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <a href={`/${collectionRoute(prev.collection)}/${prev.slug}`} class="group p-4 gap-3 flex items-center border rounded-lg hover:bg-black/5 hover:dark:bg-white/10 border-black/15 dark:border-white/20 blend">
      <div class="order-2 w-full h-full group-hover:text-black group-hover:dark:text-white blend">
        <div class="flex flex-wrap gap-2">
          <div class="text-sm uppercase">
            Anterior
          </div>
        </div>
        <div class="font-semibold mt-3 text-black dark:text-white">
          {prev.data.title}
        </div>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="order-1 stroke-current group-hover:stroke-black group-hover:dark:stroke-white rotate-180">
        <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
        <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
      </svg>
    </a>
    <a href={`/${collectionRoute(next.collection)}/${next.slug}`} class="group p-4 gap-3 flex items-center border rounded-lg hover:bg-black/5 hover:dark:bg-white/10 border-black/15 dark:border-white/20 transition-colors duration-300 ease-in-out">
      <div class="w-full h-full text-right group-hover:text-black group-hover:dark:text-white blend">
        <div class="text-sm uppercase">
          Próximo
        </div>
        <div class="font-semibold mt-3 text-black dark:text-white">
          {next.data.title}
        </div>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:stroke-black group-hover:dark:stroke-white">
        <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
        <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
      </svg>
    </a>
  </div>
</div>
